# Copia aquest fitxer a ".env"  ->  cp .env.example .env
# i tria com vols que el SOC faci el triatge amb IA.

# -------- Mode d'IA del SOC --------
# manual    : (RECOMANAT PER COMENÇAR) sense claus ni internet. El SOC genera el
#             prompt i l'enganxes tu a qualsevol xatbot (Claude, ChatGPT, Gemini...).
# openai    : usa l'API d'OpenAI     (omple OPENAI_API_KEY)
# anthropic : usa l'API d'Anthropic  (omple ANTHROPIC_API_KEY)
# ollama    : usa un model LOCAL amb Ollama (privat, sense núvol)
AI_PROVIDER=manual

# Model opcional (si el deixes buit s'usa un per defecte raonable per a cada proveïdor)
AI_MODEL=

# Claus d'API (NOMÉS si uses openai o anthropic). NO les comparteixis ni les pugis a cap repositori.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Si uses Ollama al teu ordinador (host), deixa aquesta URL tal com està:
OLLAMA_URL=http://host.docker.internal:11434
